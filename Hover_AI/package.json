{
  "name": "hover_ai",
  "version": "1.0.0",
  "description": "HoverAI - AI-powered visual desktop assistant",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.9.0",
    "dotenv": "^17.4.2",
    "keytar": "^7.9.0",
    "msedge-tts": "^2.0.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^42.1.0"
  },
  "build": {
    "appId": "com.hoverai.app",
    "productName": "HoverAI",

    "directories": {
      "output": "dist"
    },

    "files": [
      "src/**/*",
      "eng.traineddata",
      "package.json"
    ],

    "win": {
      "target": "nsis",
      "icon": "build/HoverAI.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}